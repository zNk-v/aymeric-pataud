# =============================================================================
# aymericpataud.fr — site statique (Apache / LiteSpeed)
#
# 1. Redirections 301 depuis les anciennes URLs WordPress
# 2. Forçage HTTPS + www
# 3. Compression et cache
# 4. Page 404
#
# Les 8 URLs d'articles de blog sont INCHANGÉES et ne figurent donc pas ici.
# =============================================================================

# ---------------------------------------------------------------- 404 -------
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # ------------------------------------------------------- HTTPS + www -----
  # Deux règles, mais un seul saut dans tous les cas de figure.
  #
  # La première attrape le domaine nu, en http comme en https, et envoie
  # directement vers https://www. La seconde ne voit donc plus que du
  # http://www, qu'elle passe en https.
  #
  # La condition sur X-Forwarded-Proto couvre les hébergements où le TLS est
  # terminé par un proxy en amont : %{HTTPS} y reste vide même en https, et
  # sans cette deuxième condition la règle boucle indéfiniment.

  RewriteCond %{HTTP_HOST} !^www\.aymericpataud\.fr$ [NC]
  RewriteRule ^(.*)$ https://www.aymericpataud.fr/$1 [R=301,L]

  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^(.*)$ https://www.aymericpataud.fr/$1 [R=301,L]

  # ---------------------------------------- Anciennes URLs WordPress -------
  RewriteRule ^accueil-ap/?$                        /                                      [R=301,L]

  # URL d'aperçu renommée : la page ne vend plus, elle documente des créations
  RewriteRule ^produits-reunion/?$                  /creations-reunion/                    [R=301,L]
  RewriteRule ^aymeric-pataud-2/?$                  /aymeric-pataud/                       [R=301,L]
  RewriteRule ^chef-consultant-expert-du-gout/?$    /expertise-du-gout/                    [R=301,L]
  RewriteRule ^expertise-accompagnement/?$          /expertise-du-gout/                    [R=301,L]
  RewriteRule ^le-sur-mesure-aromatique/?$          /creation-sur-mesure/                  [R=301,L]
  RewriteRule ^nos-huiles-essentielles-culinaires/?$ /huiles-essentielles-culinaires/      [R=301,L]
  RewriteRule ^nos-huiles-essentielles/?$           /huiles-essentielles-culinaires/       [R=301,L]
  RewriteRule ^pourquoi-choisir-nos-produits/?$     /huiles-essentielles-culinaires/       [R=301,L]
  RewriteRule ^chefs-traiteurs/?$                   /chefs-et-traiteurs/                   [R=301,L]
  RewriteRule ^ils-nous-font-confiance/?$           /references/                           [R=301,L]
  RewriteRule ^contact-aymeric-pataud/?$            /contact/                              [R=301,L]
  RewriteRule ^blog-aymeric-pataud/?$               /blog/                                 [R=301,L]

  # ------------------------------------------- Reliquats WordPress ---------
  RewriteRule ^wp-admin(/.*)?$      /  [R=301,L]
  RewriteRule ^wp-login\.php$       /  [R=301,L]
  RewriteRule ^feed/?$              /blog/ [R=301,L]
  RewriteRule ^comments/feed/?$     /blog/ [R=301,L]
  RewriteRule ^author/[^/]+/?$      /aymeric-pataud/ [R=301,L]
  RewriteRule ^xmlrpc\.php$         - [G,L]

  # ------------------------------ Sitemaps Yoast -> sitemap unique ---------
  RewriteRule ^(wp-sitemap|sitemap_index|post-sitemap|page-sitemap)\.xml$ /sitemap.xml [R=301,L]

  # ------------------------------------------ URLs propres (trailing /) ----
  # Le build Next exporte des dossiers : /contact/ -> /contact/index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.*)$ /$1/ [R=301,L]
</IfModule>

# ------------------------------------------------------------ Compression --
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ----------------------------------------------------------------- Cache ---
<IfModule mod_expires.c>
  ExpiresActive On

  # Les assets Next portent un hash dans leur nom : cache long sans risque
  <FilesMatch "\.(js|css|woff2)$">
    ExpiresDefault "access plus 1 year"
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.(webp|jpg|jpeg|png|gif|svg|ico)$">
    ExpiresDefault "access plus 6 months"
  </FilesMatch>

  # Le HTML doit être revalidé à chaque déploiement
  <FilesMatch "\.html$">
    ExpiresDefault "access plus 0 seconds"
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# ------------------------------------------------------------- Sécurité ----
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
</IfModule>

# Types MIME
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType font/woff2 .woff2
</IfModule>
